---
const productLinks = [
  { href: 'https://pricely.userjot.com/feedback', label: 'Request a feature' },
  { href: 'https://pricely.userjot.com/updates', label: 'Changelog' },
  { href: 'https://pricely.userjot.com/roadmap', label: 'Roadmap' },
];
---

<footer class="border-t border-mist bg-white/70">
  <div class="section-shell py-10 space-y-8">
    <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-8">
      <div class="space-y-2 max-w-xs">
        <p class="font-display text-sm font-semibold text-ink">Pricely</p>
        <p class="text-sm text-ink-soft/70 leading-relaxed">
          Pricing for screen print and decoration shops.
        </p>
      </div>

      <div class="flex flex-wrap gap-10 sm:gap-14">
        <div class="space-y-3">
          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-brand-navy">Product</p>
          <ul class="space-y-2 text-sm text-ink-soft/70">
            {productLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener"
                  class="hover:text-ink transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="space-y-3">
          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-brand-navy">Site</p>
          <ul class="space-y-2 text-sm text-ink-soft/70">
            <li>
              <a href="/#pricing" class="hover:text-ink transition-colors">Pricing</a>
            </li>
            <li>
              <a href="/#faq" class="hover:text-ink transition-colors">FAQ</a>
            </li>
            <li>
              <a href="/privacy" class="hover:text-ink transition-colors">Privacy Policy</a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <p class="text-sm text-ink-soft/70">
      Pricely by PrintPro Strategies LLC. All rights reserved.
    </p>
  </div>
</footer>
