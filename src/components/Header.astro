---
interface Props {
  showBack?: boolean;
}

const { showBack = false } = Astro.props;
---

<header class="sticky top-0 z-50 border-b border-mist/80 bg-paper/90 backdrop-blur-md">
  <div class="section-shell flex items-center justify-between h-16 gap-3">
    <div class="flex items-center gap-2 shrink-0">
      {showBack && (
        <a href="/" class="inline-flex items-center justify-center h-9 w-9 rounded-lg border border-mist hover:bg-white transition-colors" aria-label="Back to home">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        </a>
      )}
      <a href="/" class="flex items-center gap-2.5 group">
        <img src="/logo.png" alt="Pricely" class="h-8 w-8 transition-transform duration-300 group-hover:rotate-[-6deg]" />
        <span class="font-display text-lg font-semibold tracking-tight text-ink">Pricely</span>
      </a>
    </div>
    <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-ink-soft/80">
      <a href="/#how-it-works" class="hover:text-ink transition-colors">How it works</a>
      <a href="/#features" class="hover:text-ink transition-colors">Features</a>
      <a href="/#engines" class="hover:text-ink transition-colors">Engines</a>
      <a href="/#pricing" class="hover:text-ink transition-colors">Pricing</a>
      <a href="/#faq" class="hover:text-ink transition-colors">FAQ</a>
    </nav>
    <a
      href="https://app.pricely.ink/"
      class="inline-flex items-center justify-center rounded-lg text-sm font-semibold h-9 px-4 text-white hover:opacity-90 transition-opacity shrink-0"
      style="background: linear-gradient(135deg, #4AAFF5, #1A6DA8);"
    >
      Log In
    </a>
  </div>
</header>
