---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const NAVY = '#1A6DA8';
const BLUE = '#4AAFF5';
---

<BaseLayout
  title="Page not found | Pricely"
  description="That page is not on Pricely. Head back to the homepage to see pricing engines, plans, and how to get started."
>
  <div class="min-h-screen bg-white flex flex-col">
    <Header showBack={true} />
    <main class="flex-1 flex flex-col items-center justify-center px-4 py-16 text-center">
      <div class="max-w-md space-y-4">
        <p class="text-sm font-semibold" style={`color: ${NAVY};`}>404</p>
        <h1 class="text-3xl font-bold tracking-tight">We cannot find that page</h1>
        <p class="text-gray-500">
          The link may be outdated, or the page may have moved. The homepage has the latest features, engines, and pricing.
        </p>
        <a
          href="/"
          class="inline-flex items-center justify-center h-11 px-6 rounded-md text-white font-medium hover:opacity-90 transition-opacity"
          style={`background: linear-gradient(135deg, ${BLUE}, ${NAVY});`}
        >
          Back to the homepage
        </a>
      </div>
    </main>
    <Footer />
  </div>
</BaseLayout>
